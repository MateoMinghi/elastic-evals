{
  "_comment": "One document per span. Never updated. Trace attributes copied on; input/output truncated (full content in payload-*).",
  "settings": {"index.codec": "zstd", "index.mapping.total_fields.limit": 300},
  "mappings": {
    "dynamic": "strict",
    "_routing": {"required": true},
    "properties": {
      "tenant_id": {"type": "keyword"},
      "project_id": {"type": "keyword"},
      "trace_id": {"type": "keyword"},
      "span_id": {"type": "keyword"},
      "parent_span_id": {"type": "keyword"},
      "session_id": {"type": "keyword"},
      "name": {"type": "keyword"},
      "span_kind": {"type": "keyword"},
      "type": {"type": "keyword"},
      "operation": {"type": "keyword"},
      "start_time": {"type": "date_nanos"},
      "end_time": {"type": "date_nanos"},
      "duration_ms": {"type": "float"},
      "status": {"type": "keyword"},
      "status_message": {"type": "keyword", "ignore_above": 512},
      "error_type": {"type": "keyword"},
      "service_name": {"type": "keyword"},
      "environment": {"type": "keyword"},
      "release": {"type": "keyword"},
      "user_id": {"type": "keyword"},
      "tags": {"type": "keyword"},
      "agent_name": {"type": "keyword"},
      "agent_id": {"type": "keyword"},
      "workflow_name": {"type": "keyword"},
      "provider": {"type": "keyword"},
      "request_model": {"type": "keyword"},
      "response_model": {"type": "keyword"},
      "tool_name": {"type": "keyword"},
      "tool_call_id": {"type": "keyword"},
      "usage": {"properties": {
        "input_tokens": {"type": "long"},
        "output_tokens": {"type": "long"},
        "cache_read_tokens": {"type": "long"},
        "cache_write_tokens": {"type": "long"},
        "reasoning_tokens": {"type": "long"},
        "total_tokens": {"type": "long"}
      }},
      "cost_usd": {"type": "double"},
      "price_id": {"type": "keyword"},
      "input_preview": {"type": "match_only_text"},
      "output_preview": {"type": "match_only_text"},
      "has_payload": {"type": "boolean"},
      "internal": {"type": "boolean"},
      "eval_flag": {"type": "boolean"},
      "sentry_event_id": {"type": "keyword"},
      "experiment_run_id": {"type": "keyword"},
      "experiment_item_id": {"type": "keyword"},
      "semconv_source": {"type": "keyword"},
      "record_refs": {"type": "flat_object"},
      "attributes": {"type": "flat_object"},
      "resource": {"type": "flat_object"},
      "ingested_at": {"type": "date"}
    }
  }
}
